# Copy to .env and fill in whichever provider(s) you plan to use.
# Default provider is "pollinations" — free, no key needed, no card, no signup.
PRINTLY_PROVIDER=pollinations

# Pollinations model — "sana" (Sana Sprint 1.6B, fast + free) is the default.
# Override only if Pollinations adds/renames models later.
POLLINATIONS_MODEL=sana

# Optional, still free — get a token from https://auth.pollinations.ai to move
# from Anonymous tier (1 request/15s) to Seed tier (1 request/5s). Leave blank
# to stay anonymous; it still works, just queues customers more under load.
POLLINATIONS_API_TOKEN=

# Only needed if you switch PRINTLY_PROVIDER to "gemini"
GEMINI_API_KEY=

# Only needed if you switch PRINTLY_PROVIDER to "replicate" (paid, ~Rs 0.28/image, for real client logos)
REPLICATE_API_TOKEN=

# ── Auth / sessions ──────────────────────────────────────────────
# Required for real login sessions. Generate once with:
#   python -c "import secrets;print(secrets.token_hex(32))"
# and never change it in production (changing it logs everyone out).
FLASK_SECRET_KEY=

# The email that becomes an admin automatically on signup. Set this
# BEFORE you sign up your own account, so you actually get the role.
ADMIN_EMAIL=

# ── Deployment ───────────────────────────────────────────────────
# Set to "production" on your live host — enables secure cookies (HTTPS
# only) and turns off the Flask debug fallback. Leave unset for local dev.
FLASK_ENV=

# Your deployed frontend's exact origin (e.g. https://printly.in) — locks
# CORS down to just that origin. Leave unset for local dev / ngrok testing.
FRONTEND_ORIGIN=

# Where the SQLite file lives. Leave unset for local dev (defaults next to
# this file). On a host with an ephemeral filesystem (most PaaS), THIS
# MUST point at a persistent disk/volume mount, or every redeploy wipes
# all users/orders.
DB_PATH=

# Where print-ready artwork files are written. Defaults to an "artwork"
# folder next to the DB, so setting DB_PATH to a volume covers this too.
# Set it explicitly only if the two need to live apart. An order whose
# artwork is missing cannot be printed — this belongs on a volume.
ART_DIR=

# ── Email (Resend) ───────────────────────────────────────────────
# Leave RESEND_API_KEY blank and email is simply OFF: every send is
# recorded in the admin Email log as "not sent" and nothing breaks. No
# order, shipment or ticket reply ever fails because of mail.
#
# To turn it on: create a key at https://resend.com/api-keys, and verify
# the sending domain under Resend → Domains (it prints the DNS records to
# add at your registrar).
RESEND_API_KEY=

# The verified domain mail is sent from. One verified domain covers every
# address on it, so hello@, orders@ and support@ all work from this one.
MAIL_DOMAIN=printengine.in

# Where customer replies land. Point this at a mailbox someone actually
# reads — a Reply-To that bounces is worse than an unbranded one.
MAIL_REPLY_TO=printengine.in@gmail.com

# Absolute base URL used to build links inside emails (order tracking,
# password reset). The frontend only ever builds relative URLs, which are
# meaningless in an inbox. Set this to your real origin in production.
PUBLIC_BASE_URL=https://printengine.in

# ── Payments (Razorpay) ──────────────────────────────────────────
# Leave these blank and online payment is simply OFF: the cart offers only
# Cash on Delivery and orders behave exactly as they did before a gateway
# existed. Nothing breaks without them.
#
# Test keys work immediately from the Razorpay dashboard with no KYC, and
# are what you should use until you have a GSTIN — a live key means you are
# collecting real GST against a number you may not have yet.
RAZORPAY_KEY_ID=

# The secret half. Never ships to the browser; RAZORPAY_KEY_ID does, which
# is fine and by design — Checkout needs it client-side.
RAZORPAY_KEY_SECRET=

# Set separately in Razorpay under Settings -> Webhooks, pointing at
# https://<your-domain>/api/payments/webhook with the payment.captured and
# payment.failed events. WITHOUT THIS the webhook rejects everything, and
# a customer who closes the tab mid-payment will have their money taken
# with the order left pending — the browser callback alone is not enough.
RAZORPAY_WEBHOOK_SECRET=
