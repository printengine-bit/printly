# Copy to .env and fill in whichever provider(s) you plan to use.
# Default provider is "pollinations" — free, no key needed, no card, no signup.
PRINTLY_PROVIDER=pollinations

# Pollinations model — "sana" (Sana Sprint 1.6B, fast + free) is the default.
# Override only if Pollinations adds/renames models later.
POLLINATIONS_MODEL=sana

# Optional, still free — get a token from https://auth.pollinations.ai to move
# from Anonymous tier (1 request/15s) to Seed tier (1 request/5s). Leave blank
# to stay anonymous; it still works, just queues customers more under load.
POLLINATIONS_API_TOKEN=

# Only needed if you switch PRINTLY_PROVIDER to "gemini"
GEMINI_API_KEY=

# Only needed if you switch PRINTLY_PROVIDER to "replicate" (paid, ~Rs 0.28/image, for real client logos)
REPLICATE_API_TOKEN=
