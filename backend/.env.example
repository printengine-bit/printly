# Copy to .env and fill in whichever provider(s) you plan to use.
# Default provider is "pollinations" — free, no key needed, no card, no signup.
PRINTLY_PROVIDER=pollinations

# Pollinations model — "sana" (Sana Sprint 1.6B, fast + free) is the default.
# Override only if Pollinations adds/renames models later.
POLLINATIONS_MODEL=sana

# Optional, still free — get a token from https://auth.pollinations.ai to move
# from Anonymous tier (1 request/15s) to Seed tier (1 request/5s). Leave blank
# to stay anonymous; it still works, just queues customers more under load.
POLLINATIONS_API_TOKEN=

# Only needed if you switch PRINTLY_PROVIDER to "gemini"
GEMINI_API_KEY=

# Only needed if you switch PRINTLY_PROVIDER to "replicate" (paid, ~Rs 0.28/image, for real client logos)
REPLICATE_API_TOKEN=

# ── Auth / sessions ──────────────────────────────────────────────
# Required for real login sessions. Generate once with:
#   python -c "import secrets;print(secrets.token_hex(32))"
# and never change it in production (changing it logs everyone out).
FLASK_SECRET_KEY=

# The email that becomes an admin automatically on signup. Set this
# BEFORE you sign up your own account, so you actually get the role.
ADMIN_EMAIL=

# ── Deployment ───────────────────────────────────────────────────
# Set to "production" on your live host — enables secure cookies (HTTPS
# only) and turns off the Flask debug fallback. Leave unset for local dev.
FLASK_ENV=

# Your deployed frontend's exact origin (e.g. https://printly.in) — locks
# CORS down to just that origin. Leave unset for local dev / ngrok testing.
FRONTEND_ORIGIN=

# Where the SQLite file lives. Leave unset for local dev (defaults next to
# this file). On a host with an ephemeral filesystem (most PaaS), THIS
# MUST point at a persistent disk/volume mount, or every redeploy wipes
# all users/orders.
DB_PATH=
